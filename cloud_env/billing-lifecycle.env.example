# PUBLIC deployment intent only. Copy reviewed values into the environment
# operator bundle; never include age identities or Ed25519 signing private keys.
# Tracked dev/staging/prod defaults leave every feature disabled.
LKE_BILLING_BACKUP_ENABLED=false
LKE_BILLING_RAW_RETIREMENT_ENABLED=false
LKE_BILLING_INBOX_COMPACTION_ENABLED=false
LKE_BILLING_RAW_RETENTION_AUTHORITY_ENABLED=false
LKE_BILLING_BACKUP_INTERVAL=12h
LKE_BILLING_BACKUP_ENDPOINT=https://us-sea-1.linodeobjects.com
# Actual Linode placement region, not the SigV4 signing region.
LKE_BILLING_BACKUP_REGION=us-sea
LKE_BILLING_BACKUP_SIGNING_REGION=us-east-1
# Set the actual dev/staging/prod bucket and confirm uploader is scoped only to it.
LKE_BILLING_BACKUP_BUCKET=
LKE_BILLING_BACKUP_UPLOADER_BUCKET_SCOPE=
LKE_BILLING_BACKUP_ENCRYPTION_KEY_ID=
LKE_BILLING_BACKUP_RECIPIENTS_JSON=[]
LKE_BILLING_BACKUP_VERIFIER_KEY_ID=
LKE_BILLING_BACKUP_VERIFIER_PUBLIC_KEY=
LKE_BILLING_BACKUP_RECOVERY_KEYS_JSON={}
# Empty defaults to actual CLOUD_ENV_NAME only. Explicitly acknowledge legacy
# immutable event labels if needed (e.g. ["staging"]); never rewrite records.
LKE_BILLING_BACKUP_SOURCE_EVENT_ENVIRONMENTS_JSON=
# Private dedicated scratch PVC; quota/representative load qualification required.
LKE_BILLING_BACKUP_SCRATCH_STORAGE=128Gi
LKE_BILLING_BACKUP_SCRATCH_CAPACITY_BYTES=137438953472
# Current deployment's collector identity is intentionally unchanged.
LKE_BILLING_RAW_RETENTION_CONSUMER_ID=video-cloud-mqttusage/staging
