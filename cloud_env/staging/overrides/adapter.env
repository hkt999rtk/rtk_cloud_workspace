# Provider escape hatches only. Normal resolution uses generic intent.
LKE_ACCOUNT_MANAGER_SERVICE_REGISTRATION_ENABLED=true
LKE_MQTT_FOUNDATION_REGISTRATION_ENABLED=true
LKE_SHADOW_WORKER_REGISTRATION_ENABLED=true
LKE_WEBRTC_SERVICE_REGISTRATION_ENABLED=true
LKE_VIDEO_STORAGE_SERVICE_REGISTRATION_ENABLED=true
LKE_LOGGER_SERVICE_REGISTRATION_ENABLED=true
LKE_BILLING_OTA_GRANT_HISTORY_ENABLED=true
LKE_OTA_PLATFORM_SEAL_SCHEDULE_ENABLED=false
LKE_OTA_PRODUCER_SEAL_SCHEDULE_ENABLED=false
LKE_OTA_CDN_COLLECTOR_ENABLED=false
VIDEO_CLOUD_OTA_DELIVERY_MODE=object_url
LKE_OTA_SERVICE_REGISTRATION_ENABLED=true
LKE_OTA_SERVICE_EDGE_ENABLED=true
LKE_OTA_CORE_CUTOVER_ENABLED=true
# Desired paid Logger state. Existing-environment rollout first migrates the
# source schema and Loki data, then enables these flags in the operator store.
LKE_LOGGER_RETENTION_STORAGE_ENABLED=true
LKE_LOGGER_HTTP_CORE_CUTOVER_ENABLED=true
LKE_LOGGER_MQTT_CORE_CUTOVER_ENABLED=true
LKE_LOGGER_BILLING_FACTS_ENABLED=true
LKE_LOGGER_PERIOD_SEALS_ENABLED=true
