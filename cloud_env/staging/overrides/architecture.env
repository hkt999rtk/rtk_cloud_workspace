# Full staging baseline sized for 10K concurrent/active devices.
CAPACITY_TARGET_CONNECTIONS=10000
CAPACITY_ACTIVE_DEVICES=10000
MQTT_MIN_REPLICAS=2
VIDEO_CLOUD_API_MIN_REPLICAS=2
NODE_CLASS_BROKER_MIN_COUNT=2
NODE_CLASS_GENERAL_MIN_COUNT=2
NODE_CLASS_DATABASE_MIN_COUNT=1
NODE_CLASS_DATABASE_MIN_VCPU=4
NODE_CLASS_DATABASE_MIN_MEMORY_GIB=8
POSTGRES_REQUEST_CPU=500m
POSTGRES_REQUEST_MEMORY=512Mi
POSTGRES_LIMIT_MEMORY=1Gi

# Explicit staging certificate policy; change here only with a coordinated rotation.
CERTIFICATE_INTERNAL_TLS_KEY_ALGORITHM=p256
CERTIFICATE_APP_CSR_KEY_ALGORITHMS=p256
CERTIFICATE_DEVICE_CSR_KEY_ALGORITHMS=p256

# Staging-only OTA firmware trust. The matching operator private key stays in
# ~/.config/rtk_cloud/staging/runtime/ota-manifest-private.pem (never in Git).
VIDEO_CLOUD_OTA_TRUSTED_MANIFEST_KEYS_JSON={"staging-ota-20261002":"avZuIwPUbWTM9U5sUHr5ScdAcTjukW7AbsTIySMad/w="}
