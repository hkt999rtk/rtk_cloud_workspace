# Runtime media is environment-owned and must remain in the compute region.
RUNTIME_MEDIA_STORAGE_POLICY=colocated
RUNTIME_MEDIA_STORAGE_BUCKET=rtk-cloud-staging-runtime-sg-sin-2
RUNTIME_MEDIA_STORAGE_PREFIX=environments/video-cloud-staging
RUNTIME_OTA_STORAGE_MODE=dedicated
RUNTIME_OTA_STORAGE_POLICY=colocated
RUNTIME_OTA_STORAGE_BUCKET=rtk-cloud-staging-ota-firmware-sg-sin-2
RUNTIME_OTA_STORAGE_PREFIX=environments/video-cloud-staging
RUNTIME_MEDIA_STORAGE_CUTOVER_REQUIRED=true
