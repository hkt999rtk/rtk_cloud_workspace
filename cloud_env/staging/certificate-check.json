      "cert_key": "client.crt",
      "key_key": "client.key",
      "compare_to": "pki/certissuer/client.crt",
      "subject": "account-manager",
      "purpose": "client",
      "root_file": "pki/certissuer/service-ca.crt"
    },
    {
      "id": "emqx-pki-initial",
