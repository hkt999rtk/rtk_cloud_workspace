      "dns": "mqtt-pki.video-cloud-staging-video-cloud.svc",
      "root_file": "pki/mqtt/mqtt-root.crt",
      "root_sha256": "188bb1dc25b3d131dc65f0a347192f3aeb8ed61c41ea929fca32264384408486"
