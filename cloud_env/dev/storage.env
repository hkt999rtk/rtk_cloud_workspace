# Dev media and registered OTA have separate buckets in the resolved us-sea region.
RUNTIME_MEDIA_STORAGE_POLICY=colocated
RUNTIME_MEDIA_STORAGE_BUCKET=rtk-video-media-dev-us-sea
RUNTIME_MEDIA_STORAGE_PREFIX=environments/video-cloud-dev
RUNTIME_MEDIA_STORAGE_CUTOVER_REQUIRED=true
RUNTIME_OTA_STORAGE_MODE=dedicated
RUNTIME_OTA_STORAGE_POLICY=cross-region
RUNTIME_OTA_STORAGE_REGION=us-lax
RUNTIME_OTA_STORAGE_BUCKET=rtk-ota-firmware-dev-us-lax
RUNTIME_OTA_STORAGE_PREFIX=environments/video-cloud-dev
