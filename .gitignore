# Local private-cloud evidence bundles generated by scripts/collect-private-cloud-evidence.sh
evidence/

# Local E2E/load test artifacts
.artifacts/

# Operator-local deployment and test key material. Never commit real keys,
# certificates, tokens, or generated certsets.
keys/
.secrets/
.secrets.backup
.secrets.backup/
cloud_env/*
!cloud_env/dev/
!cloud_env/staging/
!cloud_env/prod/
cloud_env/dev/*
cloud_env/staging/*
cloud_env/prod/*
!cloud_env/dev/environment.env
!cloud_env/dev/deployment.env
!cloud_env/dev/overrides/
!cloud_env/dev/overrides/*.env
!cloud_env/staging/environment.env
!cloud_env/staging/deployment.env
!cloud_env/staging/overrides/
!cloud_env/staging/overrides/*.env
!cloud_env/prod/environment.env
!cloud_env/prod/deployment.env
!cloud_env/prod/overrides/
!cloud_env/prod/overrides/*.env
cloud_env/*/runtime/

# Local deploy/provision outputs.
output/
tmp/

# Local RAG runtime index/cache.
.rag/

# Local Python/editor artifacts.
__pycache__/
*.pyc
.DS_Store
