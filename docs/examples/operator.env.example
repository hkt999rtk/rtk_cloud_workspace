# RTK Cloud operator-local environment example.
#
# Store each value as its own 0600 file under
# ~/.config/rtk_cloud/<environment>/operator/env/<VARIABLE_NAME>.
# Do not commit real values or paste them into logs, issues, PRs, reports, or chat.

# Required for LKE plan/provision/discovery and Linode-owned resource cleanup.
# Owner: Linode account owner. Operations: provision, ephemeral-test, remove.
LINODE_TOKEN=<linode-api-token>

# Required when the pinned service images are private in GHCR.
# Owner: GitHub organization/package owner. Operations: provision, image resolve.
GHCR_PULL_USERNAME=<github-username>
GHCR_PULL_TOKEN=<github-token-with-read-packages>

# Conditional: required when the resolved plan uses Linode Object Storage and
# workload credentials are not supplied by an approved external secret source.
# Owner: Linode Object Storage owner. Operations: provision, clip/storage tests.
LINODE_OBJ_ACCESS_KEY_ID=<linode-object-storage-access-key>
LINODE_OBJ_SECRET_ACCESS_KEY=<linode-object-storage-secret-key>

# Required when cloud_env/<environment>/deployment.env selects DNS_ADAPTER=godaddy.
# Owner: DNS zone owner. Operations: provision and remove DNS ownership records.
GODADDY_KEY=<godaddy-api-key>
GODADDY_SECRET=<godaddy-api-secret>
# GoDaddy production credentials require prod. The tracked DNS adapter default
# normally supplies this value; keep it here only for an explicit operator override.
# GODADDY_ENV=prod

# Route53 alternative: do not set GoDaddy keys when DNS_ADAPTER=route53.
# The deployer uses the AWS SDK default credential chain. These are examples of
# process-level inputs supported by that chain, not required tracked config.
# Owner: AWS account/role owner. Operations: provision and remove DNS records.
# AWS_ACCESS_KEY_ID=<aws-access-key-id>
# AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
# AWS_SESSION_TOKEN=<aws-session-token-when-required>
# AWS_PROFILE=<approved-profile-name>

# Optional load-test/controller overrides. Prefer the documented defaults.
# Owner: test operator. Operations: capacity plan, preflight, run, cleanup.
# HOME100K_SSH_KEY=/absolute/path/to/id_ed25519_rtkcloud
# HOME100K_ENV_ROOT=/absolute/path/to/cloud_env/staging/runtime
