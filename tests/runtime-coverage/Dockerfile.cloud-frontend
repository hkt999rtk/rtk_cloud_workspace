FROM golang:1.24-alpine AS builder
WORKDIR /src
COPY . .
COPY --from=runtime_coverage_helper coverage_flush.go ./cmd/server/zz_runtime_coverage_flush.go
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -cover -covermode=atomic -coverpkg=./... -trimpath -o /out/server ./cmd/server
FROM alpine:3.22
WORKDIR /app
RUN addgroup -S app && adduser -S -G app app && mkdir -p /data && chown -R app:app /app /data
COPY --from=builder /out/server /app/server
COPY --from=builder /src/content /app/content
COPY --from=builder /src/templates /app/templates
COPY --from=builder /src/static /app/static
ENV PORT=8080 DATABASE_PATH=/data/connectplus.db ANALYTICS_DATABASE_PATH=/data/analytics.db
USER app
EXPOSE 8080
ENTRYPOINT ["/app/server"]
