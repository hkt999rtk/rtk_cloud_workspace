FROM golang:1.24-bookworm AS builder
WORKDIR /src
COPY . .
COPY --from=runtime_coverage_helper coverage_flush.go ./cmd/server/zz_runtime_coverage_flush.go
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -cover -covermode=atomic -coverpkg=./... -trimpath -o /out/server ./cmd/server
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -o /out/migrate ./cmd/migrate
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -o /out/rtk-account-manager-outbox-worker ./cmd/outbox-worker
FROM debian:bookworm-slim
WORKDIR /app
RUN useradd -r -u 10001 app && chown app:app /app
COPY --from=builder /out/server /app/server
COPY --from=builder /out/migrate /app/rtk-account-manager-migrate
COPY --from=builder /out/rtk-account-manager-outbox-worker /app/rtk-account-manager-outbox-worker
COPY --from=builder /src/migrations /app/migrations
USER app
EXPOSE 8080
ENTRYPOINT ["/app/server"]
