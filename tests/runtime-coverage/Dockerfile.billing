FROM golang:1.25-bookworm AS builder
WORKDIR /src
COPY . .
COPY --from=runtime_coverage_helper coverage_flush.go ./cmd/server/zz_runtime_coverage_flush.go
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -cover -covermode=atomic -coverpkg=./... -trimpath -o /out/rtk-billing ./cmd/server
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -o /out/rtk-billing-payment-worker ./cmd/payment-worker
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -o /out/rtk-billing-payment-simulator ./cmd/payment-simulator
FROM debian:bookworm-slim
WORKDIR /app
RUN useradd -r -u 10001 app && chown app:app /app
COPY --from=builder /out/rtk-billing /rtk-billing
COPY --from=builder /out/rtk-billing-payment-worker /rtk-billing-payment-worker
COPY --from=builder /out/rtk-billing-payment-simulator /rtk-billing-payment-simulator
COPY --from=builder /src/migrations /app/migrations
USER app
EXPOSE 8080
ENTRYPOINT ["/rtk-billing"]
