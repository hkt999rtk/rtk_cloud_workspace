FROM golang:1.25-bookworm AS builder
WORKDIR /src
COPY . .
COPY --from=runtime_coverage_helper coverage_flush.go /tmp/coverage_flush.go
RUN for command in api admin-token certissuer factoryenroll cleaner clipverifier clipuploadpreflight clipreconcile statistics metricsexporter turnregistry turnregistrar logingester mqttusage; do \
      cp /tmp/coverage_flush.go "./cmd/$command/zz_runtime_coverage_flush.go"; \
    done
RUN mkdir -p /out && for command in api admin-token certissuer factoryenroll cleaner clipverifier clipuploadpreflight clipreconcile statistics metricsexporter turnregistry turnregistrar logingester mqttusage; do \
      CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -cover -covermode=atomic -coverpkg=./... -trimpath -o "/out/$command" "./cmd/$command"; \
    done
FROM debian:bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/* \
    && useradd -r -u 10001 app && chown app:app /app
COPY --from=builder /out/ /app/
USER app
EXPOSE 8080
ENTRYPOINT ["/app/api"]
