# Non-secret deployed-cloud configuration. Copy values into the CI environment
# or an untracked operator env file; do not add credentials here.
CLOUD_VALIDATION_ACCOUNT_MANAGER_URL=https://account-manager.video-cloud-staging.realtekconnect.com
CLOUD_VALIDATION_VIDEO_CLOUD_URL=https://video-cloud-staging.realtekconnect.com
CLOUD_VALIDATION_DEVICE_URL=https://device.video-cloud-staging.realtekconnect.com
CLOUD_VALIDATION_MQTT_ADDR=video-cloud-staging.realtekconnect.com:8883
CLOUD_VALIDATION_ANDROID_CLOUD_SLUG=sdk-e2e-android
CLOUD_VALIDATION_IOS_CLOUD_SLUG=sdk-e2e-ios
CLOUD_VALIDATION_CA_BUNDLE=cloud_env/staging/lke/state/secrets/device-client-ca-bundle.pem
CLOUD_VALIDATION_ENV_ROOT=cloud_env/staging/lke
CLOUD_VALIDATION_CLOUD_LOGGER_URL=https://logger.video-cloud-staging.realtekconnect.com

# Optional only when a deployment exposes different readiness routes.
# CLOUD_VALIDATION_ACCOUNT_HEALTH_PATH=/v1/health
# CLOUD_VALIDATION_VIDEO_HEALTH_PATH=/healthz
# CLOUD_VALIDATION_DEVICE_HEALTH_PATH=/healthz

# Secret inputs supplied separately:
# CLOUD_VALIDATION_PLATFORM_ADMIN_TOKEN
# CLOUD_VALIDATION_VIDEO_CLOUD_ADMIN_TOKEN
# CLOUD_VALIDATION_CLOUD_LOGGER_TOKEN
# CLOUD_VALIDATION_FIXTURE_PROVIDER_COMMAND
# CLOUD_VALIDATION_FIXTURE_CLEANUP_COMMAND
# CLOUD_VALIDATION_EVIDENCE_PROVIDER_COMMAND
# Optional for a private server CA; this is not the device client CA bundle.
# CLOUD_VALIDATION_SERVER_CA_BUNDLE=/path/to/server-ca.pem
