{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realtekconnect.com/schemas/cloud-validation-runtime-bundle-v1.json",
  "type": "object",
  "required": ["schema_version", "run_id", "platform", "sdk_commit", "server_version", "brand_cloud_slug", "brand_cloud_active", "brandname", "environment_root", "test_data_db", "app"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "platform": { "enum": ["ios", "android"] },
    "validation_profile": { "enum": ["deploy", "nightly", "release"] },
    "restart_iteration": { "type": "integer", "minimum": 1 },
    "sdk_commit": { "type": "string", "minLength": 1 },
    "server_version": { "type": "string", "minLength": 1 },
    "brand_cloud_slug": { "type": "string", "minLength": 1 },
    "brand_cloud_active": { "const": true },
    "brandname": { "type": "string", "minLength": 1 },
    "environment_root": { "type": "string", "minLength": 1 },
    "test_data_db": { "type": "string", "minLength": 1 },
    "ca_bundle": { "type": "string" },
    "max_devices": { "type": "integer", "minimum": 1, "maximum": 5 },
    "duration_seconds": { "type": "integer", "minimum": 30, "maximum": 900 },
    "app": {
      "type": "object",
      "required": ["base_url", "device_id", "access_token", "device_transport_access_token", "refresh_token", "expired_access_token", "foreign_device_id", "certificate_path", "private_key_path", "pkcs12_path", "pkcs12_password", "revoked_pkcs12_path", "revoked_pkcs12_password"],
      "properties": {
        "base_url": { "type": "string" },
        "device_id": { "type": "string" },
        "access_token": { "type": "string" },
        "device_transport_access_token": { "type": "string" },
        "refresh_token": { "type": "string" },
        "expired_access_token": { "type": "string" },
        "admin_bearer_token": { "type": "string" },
        "foreign_device_id": { "type": "string" },
        "certificate_path": { "type": "string" },
        "private_key_path": { "type": "string" },
        "pkcs12_path": { "type": "string" },
        "pkcs12_password": { "type": "string" },
        "revoked_pkcs12_path": { "type": "string" },
        "revoked_pkcs12_password": { "type": "string" }
      },
      "additionalProperties": true
    },
    "local_temporary_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "resources": { "type": "array", "items": { "type": "object" } }
  },
  "additionalProperties": true
}
