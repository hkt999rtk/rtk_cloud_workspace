# Non-secret default description for the 100K Home IoT Device Shadow load test.
# Keep LINODE_TOKEN and other secrets in ~/.env, not in this file.

HOME100K_ENV_ROOT=cloud_env/staging/lke
HOME100K_BRANDNAME=RTK
HOME100K_REGION=us-sea

HOME100K_REMOTE_WORKSPACE=/root/rtk_cloud_workspace
HOME100K_REMOTE_ENV_ROOT=/root/rtk_cloud_workspace/cloud_env/staging/lke
HOME100K_REMOTE_OUT_ROOT=/var/lib/home-100k
HOME100K_SSH_USER=root
HOME100K_SSH_KEY=~/.ssh/id_ed25519
HOME100K_AUTHORIZED_KEY_FILE=~/.ssh/id_ed25519.pub

HOME100K_STATUS_INTERVAL_SECONDS=30
HOME100K_STAGE_WARM_UP=15s
HOME100K_STAGE_STEADY=45s
HOME100K_STAGE_COOL_DOWN=15s
HOME100K_RUNNER_MODE=live
HOME100K_COORDINATOR_START_DELAY_MS=3000
HOME100K_MQTT_ADDR=
HOME100K_VIDEO_CLOUD_BASE_URL=
HOME100K_ACCOUNT_MANAGER_BASE_URL=
HOME100K_NODE_RESOURCE_STATUS=1
HOME100K_K8S_NODE_RESOURCE_STATUS=1
