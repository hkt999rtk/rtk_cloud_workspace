# Lightweight MQTT/shadow validation profile. This is not the default capacity target.
# The shared formal-owner 1K fixture keeps 10% video-capable cameras so the
# fail-fast Video and Clip qualification DAGs can use the same run-scoped Brand.
HOME100K_ENVIRONMENT=staging
HOME100K_BRANDNAME=RTK
HOME100K_DEVICES=1000
HOME100K_USERS=50
HOME100K_DEVICES_PER_USER=20
HOME100K_DEVICE_PREFIX=load1k-device
HOME100K_DEVICE_MIX=light=15,switch=7,smart_plug=12,air_conditioner=10,environment_sensor=12,security_sensor=10,smart_meter=8,camera=10,door_lock=4,appliance=7,gateway=5
HOME100K_LOAD_GENERATOR_DEVICES_PER_VM=20000
HOME100K_STAGE_WARM_UP=30s
HOME100K_STAGE_STEADY=90s
HOME100K_STAGE_COOL_DOWN=30s
HOME100K_RUNNER_MODE=live
HOME100K_MQTT_ADDR=auto-public-mqtt
HOME100K_VIDEO_CLOUD_PUBLIC_BASE_URL=https://video-cloud-staging.realtekconnect.com
HOME100K_ACCOUNT_MANAGER_BASE_URL=https://account-manager.video-cloud-staging.realtekconnect.com
HOME100K_FUNCTIONAL_SUCCESS_THRESHOLD_PERCENT=99.5
HOME100K_CLIENT_TARGET_COMPLETENESS_PERCENT=100
