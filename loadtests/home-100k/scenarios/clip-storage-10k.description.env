# Mixed-device clip storage feature test. This does not change video-1k-v1.
# Secrets belong in ~/.env or the staging secret store.

HOME100K_ENVIRONMENT=staging
HOME100K_BRANDNAME=RTK
HOME100K_SCENARIO_PROFILE=clip-storage-10k-v1
HOME100K_VM_LABEL_PREFIX=clip10k

HOME100K_REMOTE_WORKSPACE=/root/rtk_cloud_workspace
HOME100K_REMOTE_ENV_ROOT=/root/rtk_cloud_workspace/cloud_env/staging/runtime
HOME100K_REMOTE_OUT_ROOT=/var/lib/home-100k
HOME100K_SSH_USER=root
HOME100K_SSH_KEY=~/.ssh/id_ed25519_rtkcloud
HOME100K_AUTHORIZED_KEY_FILE=~/.ssh/id_ed25519_rtkcloud.pub

HOME100K_STATUS_INTERVAL_SECONDS=30
HOME100K_STAGE_WARM_UP=1m
HOME100K_STAGE_STEADY=30m
HOME100K_STAGE_COOL_DOWN=45s
HOME100K_DEVICES=10000
HOME100K_DEVICES_PER_USER=20
HOME100K_LOAD_GENERATOR_DEVICES_PER_VM=20000
HOME100K_RUNNER_MODE=live
HOME100K_RUNNER_NOFILE_LIMIT=1048576
HOME100K_COMMAND_CONCURRENCY=100
HOME100K_SHADOW_COMMAND_TIMEOUT=30s
HOME100K_COORDINATOR_START_DELAY_MS=3000
HOME100K_CREDENTIAL_BUNDLE_FORMAT=sqlite-gzip
HOME100K_DEVICE_SESSION_MODEL=lifetime-subscription

HOME100K_FUNCTIONAL_SUCCESS_THRESHOLD_PERCENT=99.5
HOME100K_CLIENT_TARGET_COMPLETENESS_PERCENT=100
HOME100K_EXACT_EVENT_CORRELATION_PERCENT=100
HOME100K_AGGREGATE_CORRELATION_TOLERANCE_PERCENT=0.1
HOME100K_AGGREGATE_CORRELATION_MIN_TOLERANCE=5

HOME100K_MQTT_ADDR=auto-public-mqtt
HOME100K_MQTT_PUBLIC_LB_COUNT=1
HOME100K_VIDEO_CLOUD_PUBLIC_BASE_URL=https://video-cloud-staging.realtekconnect.com
HOME100K_VIDEO_CLOUD_TOKEN_BASE_URL=https://device.video-cloud-staging.realtekconnect.com
HOME100K_ACCOUNT_MANAGER_BASE_URL=https://account-manager.video-cloud-staging.realtekconnect.com

HOME100K_VIDEO_LOADTEST=off
HOME100K_CLIP_STORAGE_LOADTEST=auto
HOME100K_CLIP_STORAGE_CAMERA_DEVICES=1000
HOME100K_CLIP_STORAGE_CLIPS_PER_CAMERA=10
HOME100K_CLIP_STORAGE_WINDOW=30m
HOME100K_CLIP_STORAGE_POISSON_SEED=20260719
HOME100K_CLIP_STORAGE_UPLOAD_CONCURRENCY=64
HOME100K_CLIP_STORAGE_FIXTURE=e2e_test/video_cloud/load/testdata/clip_1080p_h264_3mbps_15s.mp4
HOME100K_CLIP_STORAGE_THUMBNAIL=e2e_test/video_cloud/load/testdata/thumbnail_1080p.jpg
HOME100K_CLIP_STORAGE_BUCKET=rtk-clip-staging-us-sea
HOME100K_CLIP_STORAGE_REGION=us-sea
HOME100K_CLIP_STORAGE_ENDPOINT=https://us-sea-1.linodeobjects.com

HOME100K_CLOUD_LOGGER_ENV=
HOME100K_NODE_RESOURCE_STATUS=1
HOME100K_K8S_NODE_RESOURCE_STATUS=1
