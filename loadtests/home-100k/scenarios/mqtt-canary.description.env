# Feature canary for the Home MQTT / Device Shadow path.
# test_id: E2E-HOME-SHADOW-001
# test_id: E2E-HOME-SHADOW-002
# test_id: E2E-HOME-SHADOW-003

HOME100K_ENVIRONMENT=staging
HOME100K_BRANDNAME=RTK
HOME100K_SCENARIO_PROFILE=mqtt-shadow-canary-v1
HOME100K_DEVICES=10
HOME100K_USERS=2
HOME100K_DEVICES_PER_USER=5
HOME100K_DEVICE_PREFIX=shadow-canary-device
HOME100K_DEVICE_MIX=light=10
HOME100K_LOAD_GENERATOR_DEVICES_PER_VM=20000
HOME100K_STAGE_WARM_UP=10s
HOME100K_STAGE_STEADY=30s
HOME100K_STAGE_COOL_DOWN=10s
HOME100K_RUNNER_MODE=live
HOME100K_MQTT_ADDR=auto-public-mqtt
HOME100K_FUNCTIONAL_SUCCESS_THRESHOLD_PERCENT=100
HOME100K_CLIENT_TARGET_COMPLETENESS_PERCENT=100
HOME100K_EXACT_EVENT_CORRELATION_PERCENT=100
HOME100K_AGGREGATE_CORRELATION_TOLERANCE_PERCENT=0
HOME100K_AGGREGATE_CORRELATION_MIN_TOLERANCE=0
