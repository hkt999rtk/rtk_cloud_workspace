# Provider-neutral RTK Cloud Kubernetes architecture.
DEPLOYMENT_RUNTIME=kubernetes
DEPLOYMENT_PROTECTION_PROFILE=standard
# Maximum complete update/acceptance duration and required certificate validity margin.
DEPLOYMENT_UPGRADE_WINDOW_SECONDS=1800
PKI_APP_CRL_WORKER_ENABLED=true
PKI_SERVER_CRL_DOMAIN=service,mqtt,openbao_tls
PKI_REQUIRE_USER_MFA=false
# Maintain exact domain consumer IDs in environment overrides; no inferred list.
PKI_REQUIRED_CONSUMERS_DEVICE=
PKI_REQUIRED_CONSUMERS_APP=
PKI_REQUIRED_CONSUMERS_SERVICE=
PKI_REQUIRED_CONSUMERS_MQTT=
PKI_REQUIRED_CONSUMERS_OPENBAO_TLS=
PKI_REQUIRED_BUNDLE_CONSUMERS_DEVICE=
PKI_REQUIRED_BUNDLE_CONSUMERS_APP=
PKI_REQUIRED_BUNDLE_CONSUMERS_SERVICE=
PKI_REQUIRED_BUNDLE_CONSUMERS_MQTT=
PKI_REQUIRED_BUNDLE_CONSUMERS_OPENBAO_TLS=
NODE_CLASS_LABEL_KEY=rtk.io/node-class
DEFAULT_WORKLOAD_NODE_CLASS=general
POD_SPREAD_TOPOLOGY_KEY=kubernetes.io/hostname
# Durable component targets use the selected cluster's default StorageClass
# unless an environment explicitly maintains a class binding.
DURABLE_DATA_STORAGE_CLASS=
REDIS_DATA_STORAGE=5Gi
PROMETHEUS_DATA_STORAGE=20Gi
