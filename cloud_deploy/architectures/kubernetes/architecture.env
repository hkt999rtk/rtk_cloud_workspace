# Provider-neutral RTK Cloud Kubernetes architecture.
DEPLOYMENT_RUNTIME=kubernetes
DEPLOYMENT_PROTECTION_PROFILE=standard
DEPLOYMENT_POSTGRES_BACKUP_ENABLED=false
# Maximum complete update/acceptance duration and required certificate validity margin.
DEPLOYMENT_UPGRADE_WINDOW_SECONDS=1800
PKI_APP_CRL_WORKER_ENABLED=true
PKI_SERVER_CRL_DOMAIN=service,mqtt,openbao_tls
PKI_REQUIRE_USER_MFA=false
# Initial shared consumer baseline for all environments; review membership before
# PKI activation/rotation. Configuration is not evidence of installed trust/acks.
# CONSUMERS: service IDs allowed to read/ack each domain's trust data; their
# acknowledgments gate revocation and Root-distrust completion.
# BUNDLE_CONSUMERS: IDs that must load/ack trust bundles before issuer activation;
# currently the same list. An empty bundle list inherits its domain's CONSUMERS.
# These are automatic service acknowledgments, not human approvals or Pod names.
# Listing a service does not enable its acknowledgment integration or rotate keys.
PKI_REQUIRED_CONSUMERS_DEVICE=video-cloud-api,pkibroker
PKI_REQUIRED_CONSUMERS_APP=video-cloud-api,pkibroker
PKI_REQUIRED_CONSUMERS_SERVICE=certissuer,pki-controller
PKI_REQUIRED_CONSUMERS_MQTT=video-cloud-api
PKI_REQUIRED_CONSUMERS_OPENBAO_TLS=certissuer,pki-controller
PKI_REQUIRED_BUNDLE_CONSUMERS_DEVICE=video-cloud-api,pkibroker
PKI_REQUIRED_BUNDLE_CONSUMERS_APP=video-cloud-api,pkibroker
PKI_REQUIRED_BUNDLE_CONSUMERS_SERVICE=certissuer,pki-controller
PKI_REQUIRED_BUNDLE_CONSUMERS_MQTT=video-cloud-api
PKI_REQUIRED_BUNDLE_CONSUMERS_OPENBAO_TLS=certissuer,pki-controller
NODE_CLASS_LABEL_KEY=rtk.io/node-class
DEFAULT_WORKLOAD_NODE_CLASS=general
POD_SPREAD_TOPOLOGY_KEY=kubernetes.io/hostname
# StorageClass for NEW Redis and Prometheus PVCs only; not PostgreSQL or OpenBao.
# LKE choices: linode-block-storage-retain (Retain: keep the backing volume after
# PVC deletion) or linode-block-storage (Delete: delete the backing volume).
# Other Kubernetes platforms: use an existing compatible StorageClass name.
# Existing PVCs keep their class/volume; a different class requires migration.
DURABLE_DATA_STORAGE_CLASS=linode-block-storage-retain
REDIS_DATA_STORAGE=5Gi
PROMETHEUS_DATA_STORAGE=20Gi

# Shared OpenBao baseline observed in Dev/Staging on 2026-10-07.
# Ordinary upgrades retain the backend, existing claims and update semantics.
# TLS currently differs: Dev uses a managed PKI init/sidecar; Staging uses Secret
# projections. Keep their original identity bindings until explicitly migrated.
# The current Raft-only renderer still needs support for this file-storage baseline.
OPENBAO_STORAGE_BACKEND=file
OPENBAO_DATA_STORAGE=10Gi
OPENBAO_AUDIT_STORAGE=5Gi
OPENBAO_POD_MANAGEMENT_POLICY=OrderedReady
OPENBAO_UPDATE_STRATEGY=OnDelete
# Common scheduling defaults; existing deployments currently omit requests.
OPENBAO_MIN_REPLICAS=1
OPENBAO_NODE_CLASS=general
OPENBAO_REQUEST_CPU=250m
OPENBAO_REQUEST_MEMORY=256Mi

# Maintained container versions; observed Dev/Staging baseline on 2026-10-07.
# Exact digests prevent a mutable tag from changing an approved update.
POSTGRES_IMAGE=docker.io/library/postgres:16-alpine@sha256:cf78e76683b9ca8c5733cbbdce6c9262b45b6767934dd0a95e671f9a0fc20685
INGRESS_CONTROLLER_IMAGE=registry.k8s.io/ingress-nginx/controller:v1.15.1@sha256:594ceea76b01c592858f803f9ff4d2cb40542cae2060410b2c95f75907d659e1
OPENBAO_IMAGE=quay.io/openbao/openbao:2.5.4@sha256:436eaf9778cad75507ff70ea26ace30dcbe15606e619ac3823495663d7f7c115
# Shared official image versions for dev, staging and prod; no environment copies.
REDIS_IMAGE=docker.io/valkey/valkey:8-alpine@sha256:081c2f5cb575efc901aa80ff9cdbd1ec6a301682fd35e1ebb4b0990a4a4a8507
FLEET_VALKEY_IMAGE=docker.io/valkey/valkey:8-alpine@sha256:081c2f5cb575efc901aa80ff9cdbd1ec6a301682fd35e1ebb4b0990a4a4a8507
REDIS_EXPORTER_IMAGE=docker.io/oliver006/redis_exporter:v1.74.0@sha256:88862b6fc5004ead3495c16d5ba548b14e898fe6d22e7c5b93bf3df83823a9a5
MQTT_IMAGE=docker.io/emqx/emqx:5.8.7@sha256:556aea6d62134524ecd1fcca53380b460b52995344dce571d484f042d9b15e7d
PROMETHEUS_IMAGE=docker.io/prom/prometheus:v2.53.1@sha256:f20d3127bf2876f4a1df76246fca576b41ddf1125ed1c546fbd8b16ea55117e6
LOKI_IMAGE=docker.io/grafana/loki:3.5.1@sha256:a74594532eec4cc313401beedc4dd2708c43674c032084b1aeb87c14a5be1745
GRAFANA_IMAGE=docker.io/grafana/grafana:13.0.2@sha256:5dad0df181cb644a14e13617b913b261a54f7d4fd4510721dba420929f35bea2
LOG_COLLECTOR_IMAGE=docker.io/grafana/promtail:3.5.1@sha256:65bfae480b572854180c78f7dc567a4ad2ba548b0c410e696baa1e0fa6381299
ALPINE_IMAGE=docker.io/library/alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
